@@ -0,0 +1,225 @@
+package ru.voidpe.anticheat;
+
+import org.bukkit.entity.Player;
+
+import java.lang.reflect.Method;
+import java.util.Locale;
+import java.util.logging.Logger;
+
+/**
+ * Мост к встроенному в ядро Purpurbedrock анализатору устройств
+ * ({@code org.purpurmc.purpur.bedrock.BedrockPlaceholderHook}).
+ *
+ * <p>Зачем отдельный класс, а если в ядре уже есть {@code BedrockBridgeInfo}?
+ * Потому что {@code BedrockBridgeInfo} — часть <b>другого</b> плагина
+ * ({@code PurpurBedrockAC}), а не публичный API ядра. Тянуть класс из чужого
+ * jar нельзя: его может не быть. Здесь используется ровно тот же проверенный
+ * шаблон, что и в {@code BedrockBridgeInfo}: рефлексия по
+ * {@code resolveOnline(Player, String)}, один раз на класс, все ошибки глушатся.</p>
+ *
+ * <p><b>Ловушка ядра, которую обязательно надо учитывать.</b>
+ * {@code resolveOnline} отвечает не только реальными данными Geyser-сессии, но и
+ * <i>значениями по умолчанию</i>:</p>
+ * <ul>
+ *   <li>{@code is_bedrock} возвращает {@code "true"} для всех, если включён
+ *       {@code bedrock.only-allow-bedrock} (по умолчанию включён) — это признак
+ *       «сервер только для Bedrock», а НЕ «этот игрок Bedrock»;</li>
+ *   <li>{@code device} без сессии отдаёт {@code bedrock.placeholders.device.android}
+ *       (по умолчанию «Android»), {@code device_id} — {@code "android"};</li>
+ *   <li>{@code protocol} без сессии — {@code "0"}, {@code device_model} — пустую
+ *       строку.</li>
+ * </ul>
+ * <p>Поэтому «данные реальные» проверяется только по значениям, которые
+ * невозможно получить без живой Geyser-сессии: {@code protocol > 0},
+ * непустой {@code device_model} или непустой {@code xuid}. Если ни одно не
+ * подтвердилось — {@link #deviceId(Player)} вернёт {@code "unknown"}, и античит
+ * обязан работать на безопасных (более мягких) значениях, а не считать
+ * отсутствие данных нарушением.</p>
+ */
+final class BedrockCoreBridge {
+
+    /** Категории устройства, которые отдаёт ядро (см. classifyDeviceId). */
+    static final String DEVICE_UNKNOWN = "unknown";
+
+    private final Logger log;
+    private volatile Method resolveOnline;
+    private volatile boolean checked;
+    private volatile boolean reported;
+    private volatile boolean warnedWeakBlockReach;
+
+    BedrockCoreBridge(Logger log) {
+        this.log = log;
+    }
+
+    private void init() {
+        if (checked) {
+            return;
+        }
+        checked = true;
+        try {
+            Class<?> hook = Class.forName("org.purpurmc.purpur.bedrock.BedrockPlaceholderHook");
+            Method method = hook.getMethod("resolveOnline", Player.class, String.class);
+            method.setAccessible(true);
+            resolveOnline = method;
+        } catch (Throwable failure) {
+            resolveOnline = null;
+            if (!reported) {
+                reported = true;
+                log.info("Ядро без встроенного анализатора устройств ("
+                        + failure.getClass().getSimpleName()
+                        + ") — данные устройства берутся из Floodgate, "
+                        + "неизвестное состояние считается безопасным");
+            }
+        }
+    }
+
+    boolean available() {
+        init();
+        return resolveOnline != null;
+    }
+
+    private String query(Player player, String key) {
+        init();
+        Method method = resolveOnline;
+        if (method == null || player == null) {
+            return null;
+        }
+        try {
+            Object value = method.invoke(null, player, key);
+            return value == null ? null : value.toString();
+        } catch (Throwable ignored) {
+            return null;
+        }
+    }
+
+    /**
+     * Есть ли для игрока настоящие данные Geyser-сессии.
+     * Только они дают право строить на устройстве какие-либо выводы.
+     */
+    boolean sessionDataAvailable(Player player) {
+        if (player == null || !available()) {
+            return false;
+        }
+        String protocol = query(player, "protocol");
+        if (protocol != null) {
+            try {
+                if (Integer.parseInt(protocol.trim()) > 0) {
+                    return true;
+                }
+            } catch (NumberFormatException ignored) {
+                // не число — считаем отсутствием данных
+            }
+        }
+        String model = query(player, "device_model");
+        if (model != null && !model.isBlank()) {
+            return true;
+        }
+        String xuid = query(player, "xuid");
+        return xuid != null && !xuid.isBlank();
+    }
+
+    /**
+     * Машиночитаемая категория устройства:
+     * {@code windows}, {@code android}, {@code ios}, {@code xbox},
+     * {@code ps4_5}, {@code switch}, {@code phone_kbm} или {@code unknown}.
+     *
+     * <p>{@code unknown} возвращается, когда данных сессии нет: значение
+     * {@code "android"} от ядра в этом случае — это fallback, а не факт.</p>
+     */
+    String deviceId(Player player) {
+        if (player == null || !available() || !sessionDataAvailable(player)) {
+            return DEVICE_UNKNOWN;
+        }
+        String raw = query(player, "device_id");
+        if (raw == null) {
+            return DEVICE_UNKNOWN;
+        }
+        String id = raw.trim().toLowerCase(Locale.ROOT);
+        return switch (id) {
+            case "windows", "android", "ios", "xbox", "ps4_5", "switch", "phone_kbm" -> id;
+            default -> DEVICE_UNKNOWN;
+        };
+    }
+
+    /**
+     * Пинг из Geyser-сессии, мс. {@code -1} — данных нет.
+     * {@code Bukkit#getPing()} у Bedrock через Geyser часто 0, поэтому это
+     * единственный честный источник; при {@code -1} вызывающий код должен
+     * опираться на джиттер move-событий ({@link LagCompensation}).
+     */
+    int ping(Player player) {
+        if (player == null || !available() || !sessionDataAvailable(player)) {
+            return -1;
+        }
+        String raw = query(player, "ping");
+        if (raw == null) {
+            return -1;
+        }
+        try {
+            int ping = Integer.parseInt(raw.trim());
+            return ping > 0 ? ping : -1;
+        } catch (NumberFormatException ignored) {
+            return -1;
+        }
+    }
+
+    /**
+     * Во сколько раз ядро расширяет допустимую дальность по БЛОКАМ.
+     *
+     * <p>Ядро подменяет ванильную проверку в {@code ServerPlayerGameMode} и
+     * {@code ServerGamePacketListenerImpl}:
+     * {@code isWithinBlockInteractionRange(pos, 1.0)} → {@code (..., reachAllowance)},
+     * где {@code reachAllowance = bedrockBlockReachTolerance} (= 2.25 по умолчанию)
+     * при включённом {@code bedrockPreventGhostBlocks}. Это множитель к атрибуту
+     * {@code block_interaction_range} (4.5), то есть ядро разрешает добывать и
+     * ставить блоки примерно до 10 блоков.</p>
+     *
+     * <p>Античит, который отменяет блок на 7 блоках, отменял бы то, что сервер
+     * разрешает. Поэтому здесь возвращается тот же множитель.</p>
+     *
+     * <p><b>Важно:</b> при значении 2.25 проверка BlockReach фактически
+     * выключается — это следствие настройки ядра, а не античита. Правильное
+     * место для ужесточения — {@code bedrock.anti-ghost-blocks.reach-tolerance}
+     * в конфиге ядра.</p>
+     *
+     * @return множитель ≥ 1.0; 1.0 — ядро дальность не расширяет
+     */
+    double blockReachFactor(Player player) {
+        if (player == null || player.getWorld() == null) {
+            return 1.0;
+        }
+        try {
+            Object handle = player.getWorld().getClass().getMethod("getHandle").invoke(player.getWorld());
+            Object worldConfig = handle.getClass().getField("purpurConfig").get(handle);
+            Object enabled = worldConfig.getClass().getField("bedrockPreventGhostBlocks").get(worldConfig);
+            if (!(enabled instanceof Boolean on) || !on) {
+                return 1.0;
+            }
+            Object tolerance = worldConfig.getClass().getField("bedrockBlockReachTolerance").get(worldConfig);
+            if (!(tolerance instanceof Double factor) || factor <= 1.0) {
+                return 1.0;
+            }
+            if (!warnedWeakBlockReach) {
+                warnedWeakBlockReach = true;
+                log.warning(String.format(Locale.ROOT,
+                        "Ядро расширяет дальность по блокам в x%.2f: BlockReach будет ослаблен. "
+                                + "Ужесточать надо в конфиге ядра: "
+                                + "bedrock.anti-ghost-blocks.reach-tolerance = 1.0", factor));
+            }
+            return factor;
+        } catch (Throwable notThisCore) {
+            return 1.0;
+        }
+    }
+
+    /** Мобильная ОС или телефон с клавиатурой/мышью — это сенсорный класс ввода. */
+    static boolean isTouchFamily(String deviceId) {
+        return "android".equals(deviceId) || "ios".equals(deviceId) || "phone_kbm".equals(deviceId);
+    }
+
+    /** Настольная/консольная категория — здесь строгие лимиты оправданны. */
+    static boolean isDesktopOrConsole(String deviceId) {
+        return "windows".equals(deviceId) || "xbox".equals(deviceId)
+                || "ps4_5".equals(deviceId) || "switch".equals(deviceId);
+    }
+}
--- a/src/main/java/ru/voidpe/anticheat/AntiEspManager.java
+++ b/src/main/java/ru/voidpe/anticheat/AntiEspManager.java
@@ -0,0 +1,340 @@
+package ru.voidpe.anticheat;
+
+import org.bukkit.Bukkit;
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.bukkit.scheduler.BukkitTask;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import java.util.logging.Logger;
+
+/**
+ * Anti-ESP для Bedrock-клиентов: скрывает игроков, которые по серверным данным
+ * не могут быть видны, но чей клиент их всё равно рисует (читы вида ESP/Wallhack
+ * из паков Apollon/Horion/Toolbox).
+ *
+ * <p><b>Почему нельзя просто «скрывать всех и часто».</b> В ядре уже есть
+ * {@code AntiEspManager} (плагин {@code PurpurBedrockAC}), который владеет
+ * hide/show с интервалом 4 тика. Второй такой же цикл даёт конфликт владения:
+ * один плагин прячет, другой показывает — мигание игроков и лишние пакеты.
+ * Поэтому:</p>
+ * <ul>
+ *   <li>если Anti-ESP ядра активен, этот модуль <b>по умолчанию выключен</b>
+ *       ({@code anti-esp.only-if-core-inactive: true});</li>
+ *   <li>если ты сознательно ведёшь Anti-ESP здесь — выключи его в ядре
+ *       ({@code /pac} или конфиг ядра), иначе два владельца видимости;</li>
+ *   <li>сам модуль работает редко (по умолчанию раз в 10 тиков) и только по
+ *       игрокам, у которых сменилось состояние — стабильные пары не трогаются,
+ *       поэтому нет постоянного hide/show.</li>
+ * </ul>
+ *
+ * <p><b>Что считается «не должен быть виден»</b> (проверки одна за другой,
+ * каждая дёшева и не трогает чанки):</p>
+ * <ol>
+ *   <li>цель в другом мире, мертва, в другом измерении;</li>
+ *   <li>цель в режиме наблюдателя — её не должно быть видно никому;</li>
+ *   <li>цель невидима (эффект невидимости) и не подсвечена — на Bedrock
+ *       невидимость рисуется иначе, и читы её игнорируют;</li>
+ *   <li>цель за пределами серверной дистанции прорисовки;</li>
+ *   <li>цель скрыта от viewer самим сервером/плагином (Vanish, привилегии) —
+ *       такие пары мы <b>не трогаем вообще</b>, чтобы не «показать» ванишнутого.</li>
+ * </ol>
+ *
+ * <p>Ложные срабатывания тут не наказывают игрока: это сокрытие, а не VL.
+ * Но и «доказательством чита» оно не является — это профилактика. Информация о
+ * устройстве для Anti-ESP не используется.</p>
+ */
+final class AntiEspManager {
+
+    private record Pair(UUID viewer, UUID target) {
+    }
+
+    private static final class Visibility {
+        boolean hidden;
+    }
+
+    private final JavaPlugin plugin;
+    private final Logger log;
+
+    private final Map<Pair, Visibility> states = new HashMap<>();
+    private final Map<UUID, Long> joinGraceUntil = new HashMap<>();
+    /** Кому запрещено прятать (право обхода) — проверяется на тике. */
+    private final Set<UUID> bypassWarned = new HashSet<>();
+
+    private BukkitTask task;
+    private boolean coreConflictLogged;
+    private boolean disabledByCore;
+
+    private boolean enabled = true;
+    private int intervalTicks = 10;
+    private int joinGraceTicks = 60;
+    private double minDistance = 2.0;
+    private double maxDistance = 96.0;
+    private boolean hideSpectators = true;
+    private boolean hideInvisible = true;
+    private boolean onlyIfCoreInactive = true;
+
+    AntiEspManager(JavaPlugin plugin, Logger log) {
+        this.plugin = plugin;
+        this.log = log;
+    }
+
+    /** Перечитывается из конфига; вызывать из onEnable и по /vac reload. */
+    void configure(boolean enabled, int intervalTicks, int joinGraceTicks,
+                   double minDistance, double maxDistance,
+                   boolean hideSpectators, boolean hideInvisible,
+                   boolean onlyIfCoreInactive) {
+        boolean wasRunning = task != null;
+        this.enabled = enabled;
+        this.intervalTicks = Math.max(2, intervalTicks);
+        this.joinGraceTicks = Math.max(0, joinGraceTicks);
+        this.minDistance = Math.max(0.0, minDistance);
+        this.maxDistance = Math.max(this.minDistance, maxDistance);
+        this.hideSpectators = hideSpectators;
+        this.hideInvisible = hideInvisible;
+        this.onlyIfCoreInactive = onlyIfCoreInactive;
+        if (wasRunning) {
+            // Перезапуск с новыми числами; сначала честно вернуть всё, что скрыли.
+            stop(true);
+        }
+        start();
+    }
+
+    /**
+     * Второй Anti-ESP (ядро) уже владеет hide/show. Берём это из факта
+     * присутствия плагина, а не из догадок: если {@code PurpurBedrockAC} стоит
+     * и его Anti-ESP включён в конфиге, мы не вмешиваемся.
+     */
+    private boolean coreOwnsVisibility() {
+        var core = Bukkit.getPluginManager().getPlugin("PurpurBedrockAC");
+        if (core == null) {
+            return false;
+        }
+        try {
+            // У ядра это Class.forName-конфиг плагина, файл plugins/PurpurBedrockAC/config.yml.
+            java.io.File file = new java.io.File(core.getDataFolder(), "config.yml");
+            if (!file.isFile()) {
+                return true; // плагин есть, конфиг ещё не создан — считаем, что владеет он
+            }
+            org.bukkit.configuration.file.YamlConfiguration config =
+                    org.bukkit.configuration.file.YamlConfiguration.loadConfiguration(file);
+            return config.getBoolean("protection.anti-esp.enabled", true);
+        } catch (Throwable ignored) {
+            return true;
+        }
+    }
+
+    void start() {
+        if (!enabled) {
+            return;
+        }
+        if (onlyIfCoreInactive && coreOwnsVisibility()) {
+            disabledByCore = true;
+            if (!coreConflictLogged) {
+                coreConflictLogged = true;
+                log.info("Anti-ESP: владельцем видимости уже является ядро "
+                        + "(PurpurBedrockAC protection.anti-esp.enabled=true) — "
+                        + "модуль VAC не запускается, чтобы не было мигания игроков. "
+                        + "Нужен Anti-ESP здесь — выключи его в ядре и поставь "
+                        + "anti-esp.only-if-core-inactive: false");
+            }
+            return;
+        }
+        disabledByCore = false;
+        task = Bukkit.getScheduler().runTaskTimer(plugin, this::tick, intervalTicks, intervalTicks);
+    }
+
+    void stop(boolean reveal) {
+        if (task != null) {
+            task.cancel();
+            task = null;
+        }
+        if (reveal) {
+            revealAll();
+        }
+        states.clear();
+        bypassWarned.clear();
+    }
+
+    /** Новый игрок: не трогаем пары в первые секунды, пока клиент грузит мир. */
+    private long readyAt(UUID uuid) {
+        return joinGraceUntil.getOrDefault(uuid, 0L);
+    }
+
+    void onJoin(Player player) {
+        joinGraceUntil.put(player.getUniqueId(), System.currentTimeMillis() + joinGraceTicks * 50L);
+        // Свежий серверный Player — старое состояние пар недействительно.
+        states.keySet().removeIf(pair -> pair.viewer().equals(player.getUniqueId())
+                || pair.target().equals(player.getUniqueId()));
+    }
+
+    void onQuit(Player player) {
+        UUID id = player.getUniqueId();
+        joinGraceUntil.remove(id);
+        revealForTarget(id);
+        states.keySet().removeIf(pair -> pair.viewer().equals(id) || pair.target().equals(id));
+    }
+
+    private void revealForTarget(UUID targetId) {
+        var target = Bukkit.getEntity(targetId);
+        for (var entry : states.entrySet()) {
+            if (!entry.getKey().target().equals(targetId) || !entry.getValue().hidden) {
+                continue;
+            }
+            Player viewer = Bukkit.getPlayer(entry.getKey().viewer());
+            // Показываем без проверки canSee: скрытие наше, поэтому canSee == false
+            // именно из-за нас — этим условием игрок остался бы невидимым навсегда.
+            if (viewer != null && target != null) {
+                viewer.showEntity(plugin, target);
+            }
+            entry.getValue().hidden = false;
+        }
+    }
+
+    private void revealAll() {
+        for (var entry : states.entrySet()) {
+            if (!entry.getValue().hidden) {
+                continue;
+            }
+            Player viewer = Bukkit.getPlayer(entry.getKey().viewer());
+            var target = Bukkit.getEntity(entry.getKey().target());
+            // Без проверки canSee — см. комментарий в revealForTarget.
+            if (viewer != null && target != null) {
+                viewer.showEntity(plugin, target);
+            }
+            entry.getValue().hidden = false;
+        }
+    }
+
+    /** Полный сброс (reload/выключение): вернуть всем всё, что мы скрыли. */
+    void reset() {
+        revealAll();
+        states.clear();
+        joinGraceUntil.clear();
+    }
+
+    boolean running() {
+        return task != null;
+    }
+
+    boolean disabledByCore() {
+        return disabledByCore;
+    }
+
+    private void tick() {
+        long now = System.currentTimeMillis();
+        joinGraceUntil.entrySet().removeIf(entry -> entry.getValue() <= now);
+
+        var players = Bukkit.getOnlinePlayers();
+        Set<Pair> visited = new HashSet<>();
+
+        for (Player viewer : players) {
+            if (!viewer.isOnline() || viewer.isDead()) {
+                continue;
+            }
+            if (viewer.hasPermission("voidanticheat.bypass")) {
+                continue;
+            }
+            if (now < readyAt(viewer.getUniqueId())) {
+                continue;
+            }
+            UUID viewerId = viewer.getUniqueId();
+            String world = viewer.getWorld().getName().toLowerCase(Locale.ROOT);
+
+            for (Player target : players) {
+                if (target.getUniqueId().equals(viewerId)) {
+                    continue;
+                }
+                Pair pair = new Pair(viewerId, target.getUniqueId());
+                visited.add(pair);
+                Visibility state = states.computeIfAbsent(pair, key -> new Visibility());
+
+                // Чужое скрытие (Vanish, привилегии, другой плагин).
+                //
+                // Важно: canSee() == false и тогда, когда скрыли МЫ САМИ, поэтому
+                // проверять надо вместе с нашим состоянием. Иначе мы бы
+                // «забывали» собственное скрытие на следующем тике, теряли
+                // владение парой и оставляли игрока невидимым навсегда.
+                if (!state.hidden && !viewer.canSee(target)) {
+                    continue; // скрывает кто-то другой — не вмешиваемся
+                }
+                if (now < readyAt(target.getUniqueId())) {
+                    continue;
+                }
+
+                boolean shouldHide = shouldHide(viewer, target, world);
+                if (shouldHide && !state.hidden) {
+                    viewer.hideEntity(plugin, target);
+                    state.hidden = true;
+                } else if (!shouldHide && state.hidden) {
+                    viewer.showEntity(plugin, target);
+                    state.hidden = false;
+                }
+            }
+        }
+
+        // Пары, которые больше не встречаются (смена мира/выход) — отпускаем.
+        states.entrySet().removeIf(entry -> {
+            if (visited.contains(entry.getKey())) {
+                return false;
+            }
+            if (entry.getValue().hidden) {
+                Player viewer = Bukkit.getPlayer(entry.getKey().viewer());
+                var target = Bukkit.getEntity(entry.getKey().target());
+                if (viewer != null && target != null) {
+                    viewer.showEntity(plugin, target);
+                }
+            }
+            return true;
+        });
+    }
+
+    /**
+     * Игрок, который сейчас работает с серверным GUI (сундук, магазин
+     * DeluxeMenus, меню VoidShulker/кейсов), не должен внезапно исчезать из
+     * мира: клиент может не перерисовать инвентарь, а в Bedrock это выглядит
+     * как зависшее меню. Пока инвентарь открыт — не трогаем пару.
+     */
+    private boolean busyWithMenu(Player target) {
+        try {
+            var open = target.getOpenInventory();
+            return open != null && open.getTopInventory() != null
+                    && !(open.getTopInventory().getType() == org.bukkit.event.inventory.InventoryType.CRAFTING);
+        } catch (Throwable ignored) {
+            return false;
+        }
+    }
+
+    private boolean shouldHide(Player viewer, Player target, String viewerWorld) {
+        if (!target.isOnline() || target.isDead()) {
+            return false;
+        }
+        if (busyWithMenu(target) || busyWithMenu(viewer)) {
+            return false;
+        }
+        if (!target.getWorld().getName().equalsIgnoreCase(viewerWorld)) {
+            return false;
+        }
+        if (hideSpectators && target.getGameMode() == org.bukkit.GameMode.SPECTATOR) {
+            return true;
+        }
+        if (hideInvisible && target.isInvisible() && !target.isGlowing()) {
+            return true;
+        }
+        double distance;
+        try {
+            distance = viewer.getLocation().distance(target.getLocation());
+        } catch (Throwable differentWorld) {
+            return false;
+        }
+        if (distance > maxDistance) {
+            return true;
+        }
+        return distance < minDistance && minDistance > 0.0;
+    }
+}
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -0,0 +1,104 @@
+// Отдельный Gradle-плагин для ядра Purpurbedrock 26.2.
+//
+// Сборка сделана по образцу purpurbedrock-npc/build.gradle.kts из этого же
+// проекта: тот же toolchain (Java 25), те же репозитории и та же зависимость
+// на API ядра со scope compileOnly, чтобы API НЕ попадал внутрь JAR.
+//
+// Существующая Maven-сборка (pom.xml) сохранена без изменений — этот файл
+// добавляет второй, эквивалентный способ сборки под локальный API ядра.
+//
+// Версия API: по умолчанию 26.2-R0.1-SNAPSHOT — именно её публикует
+// `./gradlew :purpur-api:publishToMavenLocal` из этого ядра
+// (gradle.properties: mcVersion = 26.2). Переопределяется так:
+//   ./gradlew build -PpurpurVersion="$(ls ~/.m2/repository/org/purpurmc/purpur/purpur-api)"
+
+plugins {
+    java
+}
+
+group = "ru.voidpe"
+version = "2.0.4"
+description = "VoidAntiCheat — античит для Bedrock-игроков Purpurbedrock 26.2"
+
+// Версия API. Читается ИМЕННО из -PpurpurVersion / gradle.properties:
+//   ./gradlew build -PpurpurVersion=26.2-R0.1-SNAPSHOT
+// Если свойство не передано — используется версия, которую публикует это ядро
+// (gradle.properties: mcVersion = 26.2  ->  26.2-R0.1-SNAPSHOT).
+// Проверить, что свойство реально видно сборке:
+//   ./gradlew -q properties -PpurpurVersion=X | grep '^version:'
+val purpurApiVersion = providers.gradleProperty("purpurVersion").orElse("26.2-R0.1-SNAPSHOT")
+
+// Задача-проверка: печатает фактическую координату API. Позволяет убедиться,
+// что -PpurpurVersion реально прочитан, не запуская компиляцию:
+//   ./gradlew -q printApiVersion -PpurpurVersion=26.2-R0.1-SNAPSHOT
+tasks.register("printApiVersion") {
+    doLast {
+        println("[VoidAntiCheat] org.purpurmc.purpur:purpur-api:${purpurApiVersion.get()} (compileOnly)")
+    }
+}
+
+java {
+    toolchain {
+        languageVersion.set(JavaLanguageVersion.of(25))
+    }
+}
+
+repositories {
+    // Локальный API, опубликованный из ядра: :purpur-api:publishToMavenLocal
+    mavenLocal()
+    maven("https://repo.purpurmc.org/snapshots")
+    maven("https://repo.papermc.io/repository/maven-public/")
+    mavenCentral()
+}
+
+dependencies {
+    // Только для компиляции: внутрь JAR не попадает.
+    // Пустое/пробельное значение -PpurpurVersion ломает резолв — проверяем явно.
+    val apiVersion = purpurApiVersion.get().trim()
+    require(apiVersion.isNotEmpty()) { "-PpurpurVersion не может быть пустым" }
+    compileOnly("org.purpurmc.purpur:purpur-api:$apiVersion")
+}
+
+tasks.withType<JavaCompile> {
+    options.encoding = Charsets.UTF_8.name()
+    options.release.set(25)
+    options.compilerArgs.addAll(listOf("-Xlint:-deprecation", "-Xlint:-removal"))
+}
+
+// Ресурсы не фильтруются: версия в plugin.yml — литерал, как в
+// purpurbedrock-npc и purpurbedrock-anticheat этого проекта. Это снимает
+// зависимость от `expand`/`filter` (в Gradle 9 `expand` устарел) и исключает
+// ситуацию, когда в JAR уезжает незаменённый плейсхолдер.
+tasks.processResources {
+    filteringCharset = Charsets.UTF_8.name()
+}
+
+tasks.jar {
+    archiveBaseName.set("VoidAntiCheat")
+    archiveVersion.set(project.version.toString())
+    // Ничего лишнего: в JAR только свои классы и ресурсы. Явный from(...)
+    // здесь не нужен — main-вывод попадает в jar автоматически, а повторное
+    // добавление давало бы дубли записей.
+}
+
+// Проверка, что API не попал в артефакт: если кто-то случайно заменит
+// compileOnly на implementation, сборка упадёт здесь, а не на сервере.
+tasks.register("verifyNoApiInJar") {
+    dependsOn(tasks.jar)
+    doLast {
+        val jarFile = tasks.jar.get().archiveFile.get().asFile
+        java.util.zip.ZipFile(jarFile).use { zip ->
+            val leaked = zip.entries().asSequence()
+                .map { it.name }
+                .filter { it.startsWith("org/purpurmc/") || it.startsWith("org/bukkit/") || it.startsWith("io/papermc/") }
+                .toList()
+            if (leaked.isNotEmpty()) {
+                throw GradleException("В JAR попал API сервера: ${leaked.take(5)}")
+            }
+        }
+    }
+}
+
+tasks.build {
+    dependsOn("verifyNoApiInJar")
+}
--- a/settings.gradle.kts
+++ b/settings.gradle.kts
@@ -0,0 +1,8 @@
+pluginManagement {
+    repositories {
+        gradlePluginPortal()
+        maven("https://repo.papermc.io/repository/maven-public/")
+    }
+}
+
+rootProject.name = "VoidAntiCheat"
